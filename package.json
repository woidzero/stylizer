{
  "name": "stylizer",
  "description": "🧩 An actively maintained and improved fork of FlafyDev's spotify-css-editor.",
  "version": "1.0.0",
  "author": "woidzero",
  "private": true,
  "license": "MIT",
  "scripts": {
    "watch": "spicetify watch -e",
    "format": "prettier --write .",
    "build": "spicetify-creator",
    "build:meta": "node ./scripts/meta.js",
    "release": "bun run build:meta && spicetify-creator --out=dist --minify"
  },
  "dependencies": {
    "@types/is-hotkey": "^0.1.10",
    "ace-builds": "^1.43.5",
    "is-hotkey": "^0.2.0",
    "react-ace": "^14.0.1",
    "react-rnd": "^10.5.2",
    "spcr-settings": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.7.4",
    "spicetify-creator": "^1.0.17",
    "typescript": "^5.9.3"
  },
  "type": "module"
}