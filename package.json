{
  "name": "stylizer",
  "description": "🔮 Customize Spotify's look in real time.",
  "version": "1.2.0",
  "author": "woidzero",
  "private": true,
  "license": "MIT",
  "scripts": {
    "watch": "spicetify watch -e",
    "format": "prettier --write .",
    "build": "spicetify-creator",
    "build:meta": "node ./scripts/meta.js",
    "release": "bun run build:meta && spicetify-creator --out=dist --minify"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "spcr-settings": "^1.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.40.0",
    "marked": "^18.1.0",
    "prettier": "^3.9.9",
    "spicetify-creator": "^1.0.17",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "@codemirror/state": "^6.7.6"
  },
  "type": "module"
}