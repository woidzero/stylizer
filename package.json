{
  "name": "stylizer",
  "description": "🔮 Customize Spotify's look in real time.",
  "version": "1.0.0",
  "author": "woidzero",
  "private": true,
  "license": "MIT",
  "scripts": {
    "watch": "spicetify watch -e",
    "format": "prettier --write .",
    "build": "spicetify-creator",
    "build:meta": "node ./scripts/meta.js",
    "release": "bun run build:meta && spicetify-creator --out=dist --minify"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "codejar": "^4.3.0",
    "codejar-linenumbers": "^1.0.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react-draggable": "^4.5.0",
    "spcr-settings": "^1.3.1"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "knip": "^6.9.0",
    "marked": "^17.0.1",
    "prettier": "^3.7.4",
    "spicetify-creator": "^1.0.17",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
